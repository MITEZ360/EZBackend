# 统一换行符：源码一律 LF，避免 Windows 检出后 shell 脚本 / Dockerfile 失效
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.zip binary
*.gz binary

# 构建产物与锁文件不参与语言统计
pnpm-lock.yaml linguist-generated=true
go.sum linguist-generated=true
web/dist/** linguist-vendored=true
